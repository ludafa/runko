{
  "name": "@nimbo/agent",
  "version": "0.1.0",
  "description": "轮编排运行时：一轮接一轮地跑下去 —— 起/中断/收尾、待发队列、人在回路桥、崩溃恢复，外加四种宿主能力的接口与内置实现",
  "type": "module",
  "license": "ISC",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@nimbo/core": "workspace:*",
    "@nimbo/virtual-fs": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "ai": "^7"
  },
  "devDependencies": {
    "@nimbo/conformance": "workspace:*",
    "@types/node": "catalog:",
    "ai": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
