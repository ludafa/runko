{
  "name": "@nimbo/persist-postgres",
  "version": "0.0.0",
  "description": "持久化实现：PostgreSQL（pg）—— 你只有一个连接池时装这个",
  "type": "module",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@nimbo/agent": "workspace:*",
    "@nimbo/persist-kysely": "workspace:*",
    "kysely": "catalog:"
  },
  "peerDependencies": {
    "pg": "^8"
  },
  "devDependencies": {
    "@nimbo/conformance": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "kysely": "catalog:",
    "pg": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
