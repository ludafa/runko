{
  "name": "@nimbo/persist-mongo",
  "version": "0.0.0",
  "description": "持久化实现：MongoDB —— 第一个非关系型实现，直接落在三个领域接口上",
  "type": "module",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@nimbo/agent": "workspace:*",
    "@nimbo/core": "workspace:*"
  },
  "peerDependencies": {
    "mongodb": "^7"
  },
  "devDependencies": {
    "@nimbo/conformance": "workspace:*",
    "@types/node": "catalog:",
    "mongodb": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
