// 只给测试用的 Worker：vitest-pool-workers 按它起 workerd。
{
  "name": "runko-durable-object-test",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "BARE", "class_name": "BareObject" },
      { "name": "AGENT", "class_name": "AgentObject" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BareObject", "AgentObject"] }]
}
