# 仓库根 .env —— runko 全部示例（examples/09–12）与应用（chat server + web）
# 的唯一配置/密钥来源。使用方法：
#
#   cp .env.template .env      # 复制后按需填写
#
# 真实的 .env 已被 gitignore，不会提交。2026-07-12 起所有配置都收在这一个文件里
# （不再有 examples/.env 或 apps/server/.env）。读取方：apps/web(vite)、
# apps/server（dev 脚本 --env-file-if-exists=../../.env）、示例脚本
# （shared/model.ts 的 loadRootDotEnv）都读这一个文件。
#
# ── 必需性速查 ────────────────────────────────────────────────────────────
#   • 什么都不填：examples 只能跑「确定性段」（零凭证零网络）；chat app 起得来
#     但发消息会因缺模型/沙盒/仓库配置而报错。
#   • 让 chat app 完整可用（能发消息跑 agent）：必须 = DeepSeek(2) + Vercel(3)
#     + GitHub(2) 共 7 项；BETTER_AUTH_SECRET 生产必须、开发建议填。
#   • 跑某个示例的真机段：只需该示例用到的那几项（见各节标注）。
#   • 端口/URL：都有默认值，可不填；本机因与 lantai 端口冲突，建议保留下面的值。

# ─── 端口 / URL（web 经 vite、server 经 dev 脚本都读）───────────────────────
# 【全部可选，有默认值】默认 3000/5173；这里给的 3900/5273 是为避开本机上占用
# 3000/5173 的 lantai 项目。SERVER_URL/CLIENT_URL 的 host:port 要和
# SERVER_PORT/CLIENT_PORT 保持一致。
# CLIENT_URL 会进 better-auth 的 trustedOrigins —— 若与浏览器实际访问的地址不一致，
# 登录/注册会被拒（403 "Invalid origin"）。故端口一旦改动，这四项要一起改。
CLIENT_PORT=5273
SERVER_PORT=3900
SERVER_URL=http://localhost:3900
CLIENT_URL=http://localhost:5273

# ─── 模型：DeepSeek 直连 ──────────────────────────────────────────────────
# 【DEEPSEEK_API_BASE_URL + DEEPSEEK_API_TOKEN：跑任何「模型驱动」功能时必须】
#   —— chat app 发消息、examples 的模型驱动段都要它俩；两者缺一即视为未配置
#   （examples 会跳过模型段并打印指引；chat app 发消息会报 500 缺模型配置）。
#   申请：https://platform.deepseek.com → API Keys。注意 DeepSeek 目前仅支持
#   文本，API 不支持图像输入（2026-07 实测 400）。
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_TOKEN=
# 【RUNKO_MODEL：可选】覆盖模型 id。不填时：examples/12 与 chat server 默认
#   deepseek-v4-pro，其余 examples 默认 deepseek-chat。
RUNKO_MODEL=

# ─── E2B 沙盒 ─────────────────────────────────────────────────────────────
# 【E2B_API_KEY：examples/09 真机段必须；chat app 里“选了 E2B provider 的会话”也用】
#   申请：https://e2b.dev → Dashboard → API Keys（免费 hobby：$100 额度、免信用卡）。
#   仅当有会话选 E2B 时才需要（新建会话可选 vercel/e2b，见下方 SANDBOX_PROVIDER）。
E2B_API_KEY=
#
# 【E2B_TEMPLATE / E2B_TEMPLATE_MEMORY_MB / E2B_TEMPLATE_CPU_COUNT：三项均可选】
#   E2B 的 CPU/内存只能在“构建沙盒模板”时定死，它自带的 base 模板只有 512 MiB，
#   跑 npm install 会被 OOM kill；所以我们自建了 runko-chat-base（同一个 base
#   镜像，内存 1024 MiB）。首次用 E2B 前需构建一次：
#     pnpm --filter @runko-chat/node-server e2b:template
#
#   ⚠️ 三项的生效时机不同，别搞混：
#     E2B_TEMPLATE（默认 runko-chat-base）——建盒时读，改了下一个盒立刻生效。
#                                            填 base 可退回 E2B 自带模板（512 MiB）。
#     E2B_TEMPLATE_MEMORY_MB（默认 1024）——【只有构建脚本读】
#     E2B_TEMPLATE_CPU_COUNT（默认 2）  ——【只有构建脚本读】
#   后两项改完必须重跑上面的构建命令才有用，否则沙盒规格纹丝不动（E2B 不给
#   建盒时设资源的机会）。填了非正整数会直接让构建报错退出，不会静默用默认值。
E2B_TEMPLATE=
E2B_TEMPLATE_MEMORY_MB=
E2B_TEMPLATE_CPU_COUNT=

# ─── Vercel Sandbox ───────────────────────────────────────────────────────
# 【三项全部必须，用于：chat app（每个会话都在 Vercel 沙盒里跑）+ examples/10、
#   examples/12 的真机段】非 Vercel 环境下三项缺一不可：
#   VERCEL_TOKEN      —— https://vercel.com/account/settings/tokens
#   VERCEL_TEAM_ID    —— 拥有该 project 的 team（或个人账号）id
#   VERCEL_PROJECT_ID —— 用于归属沙盒用量的某个 project
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# ─── GitHub ───────────────────────────────────────────────────────────────
# 【两项都必须，用于：chat app（每个会话 clone 该仓库）+ examples/12 的真机段】
# GITHUB_REPO —— 目标仓库；SSH（git@github.com:owner/repo.git）或 HTTPS 都接受
#   （代码内部会规范化成 HTTPS —— 沙盒里没有 SSH 密钥，走 HTTPS + PAT 认证）。
# GITHUB_PAT —— fine-grained PAT，仅授权该一个仓库，权限恰好：
#   Contents: Read and write（clone/push）+ Pull requests: Read and write（建 PR）；
#   Metadata: Read 会自动带上。建议短有效期、用完 revoke。该 token 在沙盒里对模型
#   可见 —— 切勿用权限过大的 token。
GITHUB_REPO=
GITHUB_PAT=

# ─── Exa 联网搜索 ─────────────────────────────────────────────────────────
# 【EXA_API_KEY：可选】填了 chat app 的 agent 才有 web-search 工具（查网：查库的
#   最新用法、查报错、查事实）；不填则该工具根本不注册——模型看不见它，行为与
#   加这个功能之前完全一致，不会出现「调用了不可用工具」的失败卡片。
#   申请：https://exa.ai → Dashboard → API Keys。按搜索次数计费，默认每次取 5 条。
#   该 key 只在 server 进程里用，不进沙盒、不进模型上下文（与故意放进沙盒的
#   GITHUB_PAT 相反）。改完重启 chat server 生效。见 docs/features/web-search.md。
EXA_API_KEY=

# ─── Chat server 应用（apps/server）───────────────────────────────────────
# 【BETTER_AUTH_SECRET：生产必须；开发建议填】better-auth 的 session 签名密钥。
#   不填时开发环境能起但会用不安全的默认值并告警。生成：openssl rand -hex 24。
BETTER_AUTH_SECRET=
# 【SANDBOX_PROVIDER：可选，默认 vercel】新建会话未显式指定 provider 时的默认沙盒
#   厂商：vercel | e2b。用户新建会话时可逐会话覆盖；选 e2b 需上面的 E2B_API_KEY。
SANDBOX_PROVIDER=vercel
# 【SANDBOX_IDLE_TIMEOUT_MS：可选，默认 300000=5 分钟】chat 会话沙盒空闲多久后由平台
#   快照并休眠（下次发消息自动恢复）——Vercel 走 persistent 快照、E2B 走 onTimeout:pause。
SANDBOX_IDLE_TIMEOUT_MS=300000

# chat 审批链：dangerous（默认，危险命令人审）| all（全量人审）| off（不产生审批请求）
CHAT_APPROVAL_MODE=dangerous
# 审批请求无人处理时自动 deny 的超时（毫秒），默认 240000（沙盒 idle 300s 的 80%）
CHAT_APPROVAL_TIMEOUT_MS=240000
# ask_user 提问无人回答时自动超时（毫秒），默认 240000
CHAT_ASK_USER_TIMEOUT_MS=240000

# 遥测功能
TELEMETRY_DISABLED=0

# ─── 推送通知（Web Push，见 docs/features/push-notification.md）────────────
# 【三项 VAPID 全部可选；缺任何一项 = 整个推送功能静默禁用（页面上不显示铃铛、
#   服务端一条都不发、也不报错），其它功能完全照常】
#   生成一对（一个部署一对，换了密钥所有既有订阅立即作废）：
#     npx web-push generate-vapid-keys
#   VAPID_SUBJECT 必须是 mailto: 邮箱或 https: 站点 URL——推送服务要求投递方留个
#   联系方式，投递异常时它会照这个找人。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# 【CHAT_PUSH_EVENTS：可选，默认四类全开】哪几类事件发通知，逗号分隔，可选值：
#   approval（要审批）| question（agent 提问）| turn-done（一轮完成）
#   | turn-failed（一轮失败或被中断）
#   认不出的值会被忽略并在启动时告警；显式填了一个合法值都没有的内容 = 全部关闭。
CHAT_PUSH_EVENTS=
