{
  "name": "runko",
  "version": "0.0.0",
  "private": true,
  "description": "Embeddable lightweight agent SDK for Node.js",
  "type": "module",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "build": "pnpm --filter './packages/*' run build",
    "typecheck": "pnpm --filter './packages/*' run typecheck",
    "test": "pnpm --filter './packages/*' run test",
    "lint": "pnpm -r run lint && pnpm check:doc-links",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "lint:fix": "pnpm -r run lint:fix",
    "coverage": "vitest run --coverage",
    "chat:bootstrap": "pnpm --filter @runko-chat/shared run build && pnpm --filter @runko-chat/node-server run db:migrate && pnpm --filter @runko-chat/node-server run generate:openapi && pnpm --filter @runko-chat/web run generate:api",
    "chat:server": "pnpm --filter @runko-chat/shared run build && pnpm --filter @runko-chat/node-server run dev",
    "chat:web": "pnpm --filter @runko-chat/web run dev",
    "cf:dev": "pnpm --filter @runko-chat/shared run build && SERVER_URL= pnpm --filter @runko-chat/web run build && pnpm --filter @runko-chat/cloudflare-server run dev",
    "cf:deploy": "pnpm --filter @runko-chat/cloudflare-server run deploy",
    "prepare": "husky",
    "docs:dev": "pnpm --filter @runko/docs run dev",
    "docs:build": "pnpm --filter @runko/docs run build",
    "docs:preview": "pnpm --filter @runko/docs run preview",
    "docs:check": "pnpm --filter @runko/docs run check",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "test:db": "RUNKO_TEST_POSTGRES_URL=postgres://runko:runko@127.0.0.1:5433/runko RUNKO_TEST_MYSQL_URL=mysql://root:runko@127.0.0.1:3307/runko RUNKO_TEST_MONGO_URL=mongodb://127.0.0.1:27018 pnpm test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "catalog:"
  }
}
