{
  "name": "@runko-chat/node-server",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env.production --env-file-if-exists=.env.production dist/index.js",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "e2b:template": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx scripts/build-e2b-template.ts",
    "build": "pnpm run generate:openapi && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx src/db/migrate-cli.ts",
    "lab:up": "docker compose -f docker/compose.yml up -d --build --wait",
    "lab:down": "docker compose -f docker/compose.yml down -v --remove-orphans",
    "test:lab": "RUNKO_TEST_LAB=1 vitest run test/e2e/lab.e2e.test.ts",
    "lab:logs": "node --import tsx scripts/lab-logs.ts",
    "cluster:up": "docker compose -f docker/cluster.compose.yml up -d --build --wait --scale node=${CLUSTER_REPLICAS:-3}",
    "cluster:down": "docker compose -f docker/cluster.compose.yml down -v --remove-orphans",
    "cluster:port": "docker compose -f docker/cluster.compose.yml port --index=${CLUSTER_INDEX:-1} node 3900",
    "cluster:ps": "docker compose -f docker/cluster.compose.yml ps",
    "build:dist": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.7",
    "@hono/node-server": "^2.0.1",
    "@hono/node-ws": "^1.3.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.3.0",
    "@runko/agent": "workspace:*",
    "@runko/core": "workspace:*",
    "@runko/just-bash": "workspace:*",
    "@runko/persist-kysely": "workspace:*",
    "@runko/sandbox-e2b": "workspace:*",
    "@runko/sandbox-vercel": "workspace:*",
    "@runko/sdk": "workspace:*",
    "@runko/stream-redis": "workspace:*",
    "@runko/virtual-fs": "workspace:*",
    "@vercel/sandbox": "catalog:",
    "ai": "catalog:",
    "better-auth": "^1.6.9",
    "better-sqlite3": "^12.9.0",
    "e2b": "catalog:",
    "hono": "^4.12.16",
    "kysely": "catalog:",
    "pg": "catalog:",
    "redis": "catalog:",
    "web-push": "^3.6.7",
    "yaml": "^2.8.3",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "~13.0.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5",
    "ws": "^8.18.3"
  }
}
