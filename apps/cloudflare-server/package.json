{
  "name": "@runko-chat/cloudflare-server",
  "version": "0.0.0",
  "private": true,
  "description": "chat 应用 Cloudflare 版服务端：一个 Worker 装下前端、接口、D1、会话对象（Durable Object）与 Cloudflare 沙盒",
  "type": "module",
  "scripts": {
    "dev": "pnpm run db:migrate:local && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply runko-chat --local",
    "build": "wrangler deploy --dry-run --config test/wrangler.jsonc --outdir \"$PWD/dist\"",
    "deploy": "node scripts/deploy.mjs",
    "generate:migrations": "tsx scripts/generate-d1-migrations.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "tsx scripts/generate-d1-migrations.ts --check && vitest run"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.7",
    "@cloudflare/sandbox": "catalog:",
    "@hono/zod-openapi": "^1.3.0",
    "@runko-chat/shared": "workspace:*",
    "@runko/agent": "workspace:*",
    "@runko/core": "workspace:*",
    "@runko/durable-object": "workspace:*",
    "@runko/just-bash": "workspace:*",
    "@runko/persist-kysely": "workspace:*",
    "@runko/sandbox-cloudflare": "workspace:*",
    "@runko/sdk": "workspace:*",
    "@runko/virtual-fs": "workspace:*",
    "ai": "catalog:",
    "better-auth": "^1.6.9",
    "hono": "^4.12.16",
    "kysely": "catalog:",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^4.20260601.0",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "better-sqlite3": "^12.9.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "~13.0.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5",
    "wrangler": "^4.112.0"
  }
}
