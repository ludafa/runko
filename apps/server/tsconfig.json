{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["es2015", "es2016", "es2017", "es2022"],
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", "dist"],
}
